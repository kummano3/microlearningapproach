<script type="text/html" id="hubsrc"></script>
<script>
/* ---------- scaling ---------- */
const stage = document.getElementById('stage');
function fit(){ stage.style.setProperty('--s', Math.min(innerWidth / 1600, innerHeight / 900)); }
addEventListener('resize', fit); fit();

const I = {
  search:'<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  layers:'<path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5"/>',
  film:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M17 9h4M3 15h4M17 15h4"/>',
  upload:'<path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3M12 4v12M7 9l5-5 5 5"/>',
  chart:'<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>'
};
const svg = (p, c = 'i') => `<svg class="${c}" viewBox="0 0 24 24">${p}</svg>`;

/* ---------- scene 3: pipeline ---------- */
const PH = [
  { n:'Analyze', col:'#1D63C6', ic:I.search, who:'BDMs + Instructional Designer',
    pts:['A BDM picks a topic and shares a recording, deck or demo', 'They mark the exact timestamps worth keeping', 'It is logged in the tracker by technology, persona and topic'], out:'Topic in the tracker' },
  { n:'Design', col:'#0E7C8A', ic:I.layers, who:'Instructional Designer',
    pts:['Gather the recording, slides, demo and screenshots', 'Storyboard one learning objective: hook, concept, show, takeaway', 'Pick the Black Belt module to link'], out:'Production kit' },
  { n:'Develop', col:'#7A3FB8', ic:I.film, who:'Instructional Designer + Descript AI',
    pts:['Descript cuts the video from the timestamps', 'Captures a screenshot at every transition and refines the script', 'Adds an AI voiceover and renders the video'], out:'Finished video' },
  { n:'Implement', col:'#C2570C', ic:I.upload, who:'Instructional Designer + BDM review',
    pts:['BDM checks technical accuracy; quality and brand check', 'Tag by technology, persona and format', 'Publish to the hub with a Learn more link'], out:'Live on the hub' },
  { n:'Evaluate', col:'#2E8540', ic:I.chart, who:'Instructional Designer + BDMs',
    pts:['Track completion, feedback and Learn more clicks', 'Revise videos that underperform', 'Gaps become the next topics in the tracker'], out:'Next topics' }
];
const nodesEl = document.getElementById('nodes'), token = document.getElementById('token'), detail = document.getElementById('detail'), lp = document.getElementById('lp');
nodesEl.innerHTML = PH.map((p, i) => `<button class="node" data-i="${i}" style="--col:${p.col}"><span class="c">${svg(p.ic)}</span><span class="n">${p.n}</span></button>`).join('');
let pi = 0, pTimer = null, pManual = false;
function showPhase(i){
  pi = i;
  const nodes = [...nodesEl.children];
  nodes.forEach((n, k) => { n.classList.toggle('on', k === i); n.classList.toggle('done', k < i); });
  const n = nodes[i];
  token.style.left = (n.offsetLeft + n.offsetWidth / 2) + 'px';
  lp.style.strokeDashoffset = 1180 - 1180 * (i / 4);
  const p = PH[i];
  detail.innerHTML = `<div class="hd swap"><div class="num">STEP ${i + 1} OF 5</div><h3>${p.n}</h3><span class="chip">${p.who}</span></div>
    <div class="swap"><div class="lab">What happens</div><ul>${p.pts.map(x => `<li>${x}</li>`).join('')}</ul></div>
    <div class="out swap"><div class="lab">Output</div><div class="outv">${p.out}</div></div>`;
}
nodesEl.addEventListener('click', e => { const b = e.target.closest('.node'); if (!b) return; pManual = true; stopLoops(); showPhase(+b.dataset.i); });

/* ---------- scene 4: descript mock ---------- */
const STEPS = [
  ['Import', 'Upload the recording and the kit', 'Was: gather and sync files by hand'],
  ['Cut', "Keep only the BDM's timestamps", 'Was: scrub and cut on a timeline'],
  ['Capture', 'Screenshot at every transition', 'Was: capture and crop each screen'],
  ['Rewrite', 'Script refined to be clear and engaging', 'Was: write every script from scratch'],
  ['Voice', 'Built-in AI voiceover', 'Was: book a voice or re-record'],
  ['Render', 'Video generated automatically', 'Was: export and re-edit for each change']
];
const stepsEl = document.getElementById('steps'), mock = document.getElementById('mock');
stepsEl.innerHTML = STEPS.map((s, i) => `<div class="st"><span class="k">${i + 1}</span><div><b>${s[0]}</b><span>${s[1]}</span><s>${s[2]}</s></div></div>`).join('');
document.getElementById('segs').innerHTML = Array.from({ length: 14 }, (_, i) => `<i class="seg${[0, 1, 2, 6, 10, 11, 12, 13].includes(i) ? ' cut' : ''}" style="transition-delay:${i * 30}ms"></i>`).join('');
document.getElementById('wave').innerHTML = Array.from({ length: 64 }, (_, i) => `<i style="--h:${8 + Math.round(Math.abs(Math.sin(i * 1.7)) * 30)}px;animation-delay:${(i % 9) * 60}ms"></i>`).join('');
let ds = 0;
function setDev(k){
  ds = k;
  for (let j = 1; j <= 6; j++) mock.classList.toggle('s' + j, j <= k);
  [...stepsEl.children].forEach((el, j) => { el.classList.toggle('on', j === k - 1); el.classList.toggle('done', j < k - 1); });
}

/* ---------- scene 5: live hub walkthrough ---------- */
const hubFrame = document.getElementById('hubframe'), view = document.getElementById('view'), cursor = document.getElementById('cursor'), tip = document.getElementById('tip');
const SC = 0.625;
hubFrame.srcdoc = new TextDecoder().decode(Uint8Array.from(atob(document.getElementById('hubsrc').textContent.trim()), c => c.charCodeAt(0)));
const LS = [
  ['Land on the hub', 'One Cisco-branded page inside Mindtickle.'],
  ['Pick a technology', 'Eight technologies as simple tiles.'],
  ['Pick your persona', 'Engineering, Sales, Support, Customer Success or Operations.'],
  ['Pick a category', 'Formats on the left; the ones for your persona come first.', 'optional'],
  ['Watch the video', 'Plays in place, one topic at a time.'],
  ['Learn more', 'Every video links to the detailed Black Belt series.']
];
const lsEl = document.getElementById('lsteps'), clk = [...document.querySelectorAll('#clk i')];
lsEl.innerHTML = LS.map((s, i) => `<li><span class="k">${i + 1}</span><div><b>${s[0]}${s[2] ? `<em>${s[2]}</em>` : ''}</b><span>${s[1]}</span></div></li>`).join('');
function lstep(k){ [...lsEl.children].forEach((li, j) => { li.classList.toggle('on', j === k); li.classList.toggle('done', j < k); }); }
function clicks(n){ clk.forEach((c, j) => c.classList.toggle('on', j < n)); }
let demoId = 0;
const sleep = ms => new Promise(r => setTimeout(r, ms));
const hd = () => hubFrame.contentDocument, hw = () => hubFrame.contentWindow;
function showTip(html, x, y){ tip.innerHTML = html; tip.style.left = Math.min(Math.max(x - 150, 12), 900 - 312) + 'px'; tip.style.top = (y + 28 > 500 ? y - 80 : y + 28) + 'px'; tip.classList.add('show'); }
function hideTip(){ tip.classList.remove('show'); }
async function pointAt(sel, id){
  const d = hd(); const el = d && d.querySelector(sel); if (!el) return null;
  const r0 = el.getBoundingClientRect();
  if (r0.top < 70 || r0.bottom > 860) { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); await sleep(750); }
  if (id !== demoId) return null;
  const r = el.getBoundingClientRect();
  const x = (r.left + Math.min(r.width / 2, 120)) * SC, y = (r.top + r.height / 2) * SC;
  cursor.style.left = x + 'px'; cursor.style.top = y + 'px';
  await sleep(950);
  return id === demoId ? { el, x, y } : null;
}
async function press(t){ cursor.classList.remove('click'); void cursor.offsetWidth; cursor.classList.add('click'); await sleep(180); t.el.click(); }
async function runDemo(){
  const id = ++demoId;
  const ok = () => id === demoId;
  while (ok()) {
    const d = hd(); if (!d || !d.querySelector('#app')) { await sleep(300); continue; }
    try { const v = d.getElementById('viewer'); if (v && v.open) v.close(); } catch (e) {}
    hw().location.hash = '#/'; await sleep(120); hw().scrollTo(0, 0);
    hideTip(); clicks(0); lstep(0);
    cursor.style.left = '620px'; cursor.style.top = '420px';
    showTip('<b>Black Belt Bytes</b> on Mindtickle', 300, 235); await sleep(2200); if (!ok()) return; hideTip();
    // 1 technology
    lstep(1);
    let t = await pointAt('[data-tech="0"]', id); if (!t) return;
    showTip('Pick <b>Data Center</b>', t.x, t.y); await sleep(700); await press(t); clicks(1); await sleep(900); hideTip(); if (!ok()) return;
    // 2 persona
    lstep(2);
    t = await pointAt('.pcard[data-persona="0"]', id); if (!t) return;
    showTip('Pick <b>Engineering</b>', t.x, t.y); await sleep(700); await press(t); hideTip(); clicks(2); await sleep(1300); if (!ok()) return;
    hw().scrollTo(0, 0); await sleep(200);
    // 3 category (optional)
    lstep(3);
    t = await pointAt('[data-tab="4"]', id); if (!t) return;
    showTip('Switch category to <b>Features</b>', t.x, t.y); await sleep(700); await press(t); await sleep(1100); hideTip(); if (!ok()) return;
    // 4 watch
    lstep(4);
    t = await pointAt('.vcard[data-vid="0"]', id); if (!t) return;
    showTip('Open a video', t.x, t.y); await sleep(600); await press(t); hideTip(); clicks(3); await sleep(800); if (!ok()) return;
    t = await pointAt('#vplay', id); if (!t) return;
    await press(t); await sleep(2200); if (!ok()) return;
    // 5 learn more
    lstep(5);
    t = await pointAt('.vinfo .btn.cyan', id); if (!t) return;
    showTip('<b>Learn more</b> opens the full Black Belt series', t.x, t.y); await sleep(3200); hideTip(); if (!ok()) return;
    lstep(6); await sleep(1200);
  }
}
function stopDemo(){ demoId++; hideTip(); }
document.getElementById('tryit').addEventListener('click', e => {
  const live = !view.classList.contains('live');
  view.classList.toggle('live', live); e.currentTarget.classList.toggle('on', live);
  e.currentTarget.textContent = live ? 'Replay the walkthrough' : 'Explore it yourself';
  if (live) { stopDemo(); lstep(-1); clicks(0); } else runDemo();
});

/* ---------- scene engine ---------- */
const scenes = [...document.querySelectorAll('.scene')];
const dots = document.getElementById('dots'), bar = document.getElementById('bar');
dots.innerHTML = scenes.map((s, i) => `<button aria-label="Go to slide ${i + 1}: ${s.getAttribute('aria-label')}"></button>`).join('');
let cur = -1, loops = [];
function stopLoops(){ loops.forEach(clearInterval); loops.forEach(clearTimeout); loops = []; if (typeof stopDemo === 'function') stopDemo(); }
function go(i){
  i = Math.max(0, Math.min(scenes.length - 1, i));
  if (i === cur) return;
  stopLoops();
  scenes.forEach((s, k) => s.classList.toggle('active', k === i));
  [...dots.children].forEach((d, k) => d.classList.toggle('on', k === i));
  bar.style.width = ((i + 1) / scenes.length * 100) + '%';
  cur = i;
  try { history.replaceState(null, '', '#' + (i + 1)); } catch (e) {}
  const id = scenes[i].classList[1];
  if (id === 's3') {
    pManual = false; showPhase(0);
    let k = 0;
    loops.push(setTimeout(() => loops.push(setInterval(() => { if (pManual) return; k = (k + 1) % 5; showPhase(k); }, 3200)), 600));
  }
  if (id === 's4') {
    setDev(0);
    let k = 0;
    const tick = () => { k = k >= 7 ? 0 : k + 1; setDev(Math.min(k, 6)); };
    loops.push(setTimeout(() => { tick(); loops.push(setInterval(tick, 2100)); }, 700));
  }
  if (id === 's5') { view.classList.remove('live'); const tb = document.getElementById('tryit'); tb.classList.remove('on'); tb.textContent = 'Explore it yourself'; setTimeout(() => { if (cur === i) runDemo(); }, 900); }
}
dots.addEventListener('click', e => { const b = e.target.closest('button'); if (b) go([...dots.children].indexOf(b)); });
document.getElementById('prev').onclick = () => go(cur - 1);
document.getElementById('next').onclick = () => go(cur + 1);
addEventListener('keydown', e => {
  if (['ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(cur + 1); }
  if (['ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); go(cur - 1); }
  if (e.key === 'Home') go(0);
  if (e.key === 'End') go(scenes.length - 1);
  if (e.key === 'f' || e.key === 'F') { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.(); }
});
const start = parseInt((location.hash || '').slice(1), 10);
go(start >= 1 && start <= scenes.length ? start - 1 : 0);
</script>
