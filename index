  <section class="scene s5" aria-label="The learner experience">
    <div class="kicker a">Implement · the learner experience</div>
    <h2 class="a" style="--d:100">Three clicks to the right video</h2>
    <div class="lx">
      <div class="browser a" style="--d:250">
        <div class="bbar"><i style="background:#FF5F57"></i><i style="background:#FEBC2E"></i><i style="background:#28C840"></i>
          <span class="url"><svg class="i" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Mindtickle · Black Belt Bytes</span>
          <button class="tryit" id="tryit" type="button">Explore it yourself</button></div>
