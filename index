  <!-- 4 -->
  <section class="scene s4" aria-label="Develop in Descript">
    <div class="kicker a">Develop · automated in Descript</div>
    <h2 class="a" style="--d:100">Raw recording in, polished video out <span class="chip cy" style="vertical-align:middle;margin-left:14px;font-size:14px">✓ Tested and working</span></h2>
    <div class="wrap">
      <div class="mock a" style="--d:250" id="mock">
        <div class="top"><i style="background:#FF5F57"></i><i style="background:#FEBC2E"></i><i style="background:#28C840"></i><b>Descript · Fiber re-use with 400G BiDi optics</b></div>
        <div class="body">
          <div>
            <div class="prev"><div class="pl"><svg class="i" viewBox="0 0 24 24" style="fill:#fff;stroke:none"><path d="M8 5l11 7-11 7z"/></svg></div><div class="flash"></div><div class="ready">✓ Video ready</div></div>
            <div class="thumbs"><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="script">
            <div class="lab">Script</div>
            <div class="sl"><span class="old">so um basically what we're doing here is reusing the fiber…</span><span class="new">Reuse your existing fiber and move to 400G.</span></div>
            <div class="sl"><span class="old">and the optics, they kind of, you know, support both…</span><span class="new">BiDi optics carry both directions on one pair.</span></div>
